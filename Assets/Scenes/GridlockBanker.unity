--- !u!114 &1323780412
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1323780410}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FBBF24>THE IDEA</color></b>\nYou are the parking manager. Parked
    cars are a fleet's <b>Allocation</b>, cars on the street its <b>Need</b>, cars
    at the gate the <b>Request</b>, and empty bays are <b>Available</b>.\n<b>GRANT</b>
    only if every fleet could still finish afterwards (a safe sequence exists).\n\n<b><color=#FBBF24>CONTROLS</color></b>\n<b>GRANT</b>
    / <b>DENY</b> on the board, the side panel or the card above the gate, then <b>NEXT</b>.\nFive
    guided levels, then endless challenges with a speed bonus.\n\n<b>Desktop</b> 
    right-drag to orbit, scroll to zoom.\n<b>Headset</b>  left stick walk, right
    stick turn (push up to teleport). Look at a controller to see its buttons.\n<b>Hands</b> 
    point + pinch to select; pinch the ground and release to teleport; pinch + flick
    sideways to turn; left palm up for MENU.\n<b>Mixed reality</b> (Settings \u2192
    Display)  your room around a table model: right stick resize, left stick turn,
    click the right stick to bring it back in front."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
