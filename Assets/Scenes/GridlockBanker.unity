  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>HOW TO READ THE LOT</b>\n\n<b>Parked cars</b> = the fleet's <b>Allocation</b>\n<b>Cars
    on the street</b> = its remaining <b>Need</b> (Max \u2212 Allocation)\n<b>Cars
    at the gate</b> = the <b>Request</b>\n<b>Empty bays</b> = <b>Available</b>\n\nZone
    N = P1\u2013P3 (north row), Zone S = P4\u2013P6 (south row).\nGRANT only if every
    fleet could still finish afterwards."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
