  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FBBF24>THE IDEA</color></b>\nCars are <b>processes</b>, bays
    are <b>resources</b>. A car keeps its bay until the next one is free. If the
    waits close into a loop, nobody can move: a <b>deadlock</b>.\n\n<b><color=#FBBF24>CONTROLS</color></b>\n<b>Select
    a car, then a bay</b> to send it there (click, tap, or point and pull the trigger).\n<b>ANALYZE</b>
    draws who waits for whom. <b>TOW CAR</b> removes the selected car and breaks
    the loop.\n<b>RESTART</b> replays the demo. <b>GUIDED TOUR</b> explains everything
    in two minutes.\n\n<b>Desktop</b>  right-drag to orbit, scroll to zoom.\n<b>Headset</b> 
    left stick walk, right stick turn (push up to teleport). Look at a controller
    to see its buttons.\n<b>Hands</b>  point + pinch to select; pinch the ground
    and release to teleport; pinch + flick sideways to turn; left palm up for MENU.\n<b>Mixed
    reality</b> (Settings \u2192 Display)  your room around a table model: right
    stick resize, left stick turn, click the right stick to bring it back in front."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
