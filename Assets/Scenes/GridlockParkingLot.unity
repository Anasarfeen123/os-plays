  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>HOW IT WORKS</b>


    Each car is a <b>process</b>, each bay a <b>resource</b>
    that fits one car.


    A car keeps its bay until the next one is free. If that
    bay is taken it must <b>wait</b>.


    If the waits close into a loop, nobody
    can ever move: <color=#EF4444><b>deadlock</b></color>.


    <b>YOUR TURN</b> 
    Select a car, then a bay. Can you build a deadlock and break it?'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
